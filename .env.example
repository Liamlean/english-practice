# Copy this file to ".env" and fill it in:  cp .env.example .env
# On Windows:  copy .env.example .env

# --- Server ---
PORT=3000
# A long random string. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=30

# --- Database (Turso / libSQL) ---
# Leave BOTH empty to develop offline with a local SQLite file (data/app.db).
# For production (Vercel), create a free Turso database and paste its values here.
# Get them with:  turso db show <name> --url   and   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin ---
# Comma-separated usernames allowed to open the #/admin dashboard.
# Leave empty and the first registered account becomes the admin.
ADMIN_USERS=
